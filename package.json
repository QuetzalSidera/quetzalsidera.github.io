  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && next build",
    "check:post-diagrams": "node --experimental-strip-types scripts/check-post-diagrams.mjs",
    "check:post-images": "node scripts/check-post-images.mjs",
    "test:content": "node --experimental-strip-types --test tests/remark-content-directives.test.mjs tests/check-post-diagrams.test.mjs",
    "test:content:e2e": "playwright test",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit && pnpm check:post-images && pnpm check:post-diagrams"
  },
