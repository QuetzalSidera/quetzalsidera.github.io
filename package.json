    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "animejs": "^3.2.2",
    "giscus": "^1.5.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.11",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mdast-util-to-markdown": "^2.1.2",
